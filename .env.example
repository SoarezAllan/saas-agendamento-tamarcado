# Supabase PostgreSQL Connection (Transaction Pooler - Porta 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL Direct Connection (Session Pooler - Porta 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# JWT Secret para autenticação de sessões
JWT_SECRET="tamarcado_super_secret_jwt_key_2026_xpto"

# URL pública do aplicativo (em produção: https://saas-agendamento-tamarcado.vercel.app ou seu domínio próprio)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mercado Pago Gateway (Opcional no desenvolvimento, obrigatório em produção para pagamentos reais)
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_PUBLIC_KEY=""
