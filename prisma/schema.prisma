datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  passwordHash   String
  name           String
  role           String        @default("ADMIN") // SUPERADMIN, ADMIN, PROFESSIONAL
  businessId     String?
  professionalId String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  business       Business?     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
}

model Business {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  category     String         @default("Geral") // Barbearia, Salão de Beleza, Clínica, Odontologia, Pet Shop, etc.
  description  String?
  logoUrl      String?
  primaryColor String         @default("#2563eb")
  address      String?
  phone        String?
  email        String?
  serviceTerm  String         @default("Serviço") // Ex: Serviço, Consulta, Reunião, Sessão, Procedimento, Aula
  proTerm      String         @default("Profissional") // Ex: Profissional, Advogado(a), Arquiteto(a), Especialista, Médico(a), Terapeuta
  trialEndsAt  DateTime?
  planId       String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  users         User[]
  businessHours BusinessHours[]
  professionals Professional[]
  services      Service[]
  appointments  Appointment[]
  subscription  Subscription?
}

model BusinessHours {
  id         String   @id @default(cuid())
  businessId String
  dayOfWeek  Int      // 0=Domingo, 1=Segunda, ..., 6=Sábado
  isOpen     Boolean  @default(true)
  openTime   String   @default("09:00") // Formato "HH:mm"
  closeTime  String   @default("18:00")
  breakStart String?  // Ex: "12:00"
  breakEnd   String?  // Ex: "13:00"

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
}

model Professional {
  id           String                     @id @default(cuid())
  businessId   String
  name         String
  email        String?
  phone        String?
  avatarUrl    String?
  bio          String?
  active       Boolean                    @default(true)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  business       Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user           User?
  availabilities ProfessionalAvailability[]
  dateOverrides  ProfessionalDateOverride[]
  services       ServiceProfessional[]
  appointments   Appointment[]
}

model ProfessionalAvailability {
  id             String       @id @default(cuid())
  professionalId String
  dayOfWeek      Int          // 0=Domingo, ..., 6=Sábado
  isAvailable    Boolean      @default(true)
  startTime      String       @default("09:00")
  endTime        String       @default("18:00")
  breakStart     String?
  breakEnd       String?

  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, dayOfWeek])
}

model ProfessionalDateOverride {
  id             String       @id @default(cuid())
  professionalId String
  date           String       // Formato "YYYY-MM-DD"
  isAvailable    Boolean      @default(false) // false = Folga / Bloqueado, true = Trabalho Extra / Horário Especial
  startTime      String?      // "09:00"
  endTime        String?      // "18:00"
  breakStart     String?      // "12:00"
  breakEnd       String?      // "13:00"
  reason         String?      // "Folga", "Férias", "Feriado", "Plantão"
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([professionalId, date])
}

model Service {
  id              String                @id @default(cuid())
  businessId      String
  name            String
  description     String?
  durationMinutes Int                   @default(30)
  price           Float                 @default(0.0)
  priceOnRequest  Boolean               @default(false)
  category        String?
  active          Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professionals   ServiceProfessional[]
  appointments    Appointment[]
}

model ServiceProfessional {
  serviceId      String
  professionalId String

  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@id([serviceId, professionalId])
}

model Appointment {
  id             String       @id @default(cuid())
  businessId     String
  professionalId String
  serviceId      String
  customerName   String
  customerPhone  String
  customerEmail  String?
  notes          String?
  startTime      DateTime
  endTime        DateTime
  status         String       @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED, NO_SHOW
  totalPrice     Float        @default(0.0)
  manageToken    String       @unique // Token único para o cliente remarcar/cancelar
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                      String    @id @default(cuid())
  businessId              String    @unique
  plan                    String    @default("STARTER") // STARTER, PRO, ENTERPRISE
  status                  String    @default("TRIALING") // ACTIVE, TRIALING, PAST_DUE, CANCELED
  billingCycle            String    @default("MONTHLY") // MONTHLY, QUARTERLY, ANNUAL
  paymentMethod           String?   // CREDIT_CARD, PIX
  cardLastFour            String?
  cardBrand               String?
  trialEndsAt             DateTime?
  currentPeriodEnd        DateTime?
  cancelAtPeriodEnd       Boolean   @default(false)
  mercadoPagoPaymentId    String?
  mercadoPagoPreapprovalId String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  business                Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Plan {
  id                      String   @id @default(cuid())
  name                    String
  slug                    String   @unique
  priceMonthly            Float
  priceQuarterly          Float    @default(0.0)
  priceAnnual             Float    @default(0.0)
  maxProfessionals        Int
  maxServices             Int
  maxAppointmentsPerMonth Int
  features                String   // JSON string
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PageView {
  id              String   @id @default(cuid())
  path            String
  ipHash          String?
  userAgent       String?
  deviceType      String   @default("desktop") // desktop, mobile, tablet
  referrer        String?
  durationSeconds Int      @default(0)
  sessionId       String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}


